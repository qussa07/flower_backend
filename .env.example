# Preserve your existing .env; copy only missing settings.
SECRET_KEY=replace-with-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTE=30
REFRESH_TOKEN_EXPIRE_DAYS=7
POSTGRES_USER=myuser
POSTGRES_PASSWORD=password
POSTGRES_DB=mydb
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
# Optional override (the psycopg 3 driver is used):
# DATABASE_URL=postgresql+psycopg://myuser:password@localhost:5434/mydb
REDIS_URL=redis://localhost:6379

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PAYMENT_TEST_MODE=true
PAYMENT_RETURN_URL=http://localhost:3000/payment/return
PAYMENT_RECONCILE_INTERVAL=60
DELIVERY_FEE=0.00
# Configure these for the receipt solution enabled in your YooKassa account.
PAYMENT_RECEIPTS_ENABLED=false
# PAYMENT_VAT_CODE=1
PAYMENT_RECEIPT_MODE=full_prepayment
PAYMENT_RECEIPT_SUBJECT=commodity
